{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/nossos-cursos",
      "destination": "/cursos",
      "permanent": true
    },
    {
      "source": "/nossos-cursos/",
      "destination": "/cursos/",
      "permanent": true
    },
    {
      "source": "/blog/ferramentas-tecnico-ar-condicionado/",
      "destination": "/ferramentas-para-ar-condicionado/",
      "statusCode": 301
    },
    {
      "source": "/blog/",
      "has": [
        {
          "type": "query",
          "key": "categoria",
          "value": "(?<categoria>[a-z0-9-]+)"
        }
      ],
      "destination": "/:categoria/",
      "statusCode": 301
    },
    {
      "source": "/blog/:slug/",
      "destination": "/:slug/",
      "statusCode": 301
    },
    {
      "source": "/servicos/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/servicos/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/authors/equipe-curso-de-ar-condicionado/",
      "destination": "/sobre/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
