---
/**
 * Posts e categorias na raiz do site:
 * - Post: /<slug>/ (src/content/posts/*.md)
 * - Categoria: /<id-da-categoria>/ (src/content/categories/*.yaml), lista os posts daquela categoria
 */

import { getCollection, getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../themes/cursodear/BaseLayout.astro';
import BlogPost from '../themes/cursodear/BlogPost.astro';
import BlogList from '../themes/cursodear/BlogList.astro';
import { SITE } from '../data/site';
import { postSlug, newestFirst } from '../utils/post-url';
import { buildPostJsonLd, mergePostJsonLdWithFaq, toAbsoluteUrl, toIsoDateTime } from '../utils/post-json-ld';
import { resolvecursodearMediaUrl } from '../utils/media-url';
import { pickRelatedPosts } from '../utils/related-posts';
import { TECHNICAL_REVIEWER } from '../utils/seo-meta';

export async function getStaticPaths() {
  // Slugs que já são páginas próprias em src/pages/ e não podem virar post nem categoria.
  const RESERVED = new Set(['sobre', 'contato', 'automotivo', 'cursos', 'blog', 'termos', 'politica-de-privacidade', 'politica-de-cookies', 'area-do-aluno']);
  const posts = await getCollection('posts');
  const postPaths = posts
    .filter((post) => !RESERVED.has(postSlug(post)))
    .map((post) => ({ params: { slug: postSlug(post) }, props: { kind: 'post' as const, post } }));

  const taken = new Set(postPaths.map((p) => p.params.slug));
  const categories = await getCollection('categories');
  const categoryPaths = categories
    .filter((c) => !c.id.includes('/') && !taken.has(c.id) && !RESERVED.has(c.id))
    .map((category) => ({ params: { slug: category.id }, props: { kind: 'category' as const, category } }));

  return [...postPaths, ...categoryPaths];
}

type Props =
  | { kind: 'post'; post: CollectionEntry<'posts'> }
  | { kind: 'category'; category: CollectionEntry<'categories'> };

const props = Astro.props as Props;

let post: CollectionEntry<'posts'> | null = null;
let Content: any;
let author: CollectionEntry<'authors'> | undefined;
let ogImageAbs: string | undefined;
let articleIso: string | undefined;
let articleModifiedIso: string | undefined;
let postJsonLd: Record<string, unknown> | null = null;
let relatedPosts: CollectionEntry<'posts'>[] = [];
let categoryPosts: CollectionEntry<'posts'>[] = [];

if (props.kind === 'post') {
  post = props.post;
  ({ Content } = await render(post));
  author = post.data.author ? await getEntry('authors', post.data.author) : undefined;

  const pageUrl = `${SITE.url}/${postSlug(post)}/`;
  const rawImg = post.data.metaImage || post.data.image || post.data.thumbnail;
  ogImageAbs = toAbsoluteUrl(SITE.url, resolvecursodearMediaUrl(rawImg) || rawImg);
  articleIso = toIsoDateTime(post.data.publishedDate);
  articleModifiedIso = toIsoDateTime(post.data.updatedDate) || articleIso;

  const category = post.data.category ? await getEntry('categories', post.data.category) : undefined;
  postJsonLd = mergePostJsonLdWithFaq(
    buildPostJsonLd({
      seoSchema: post.data.seoSchema,
      headline: post.data.title,
      description: post.data.metaDescription || '',
      pageUrl,
      siteUrl: SITE.url,
      siteName: SITE.name,
      publishedDate: post.data.publishedDate,
      updatedDate: post.data.updatedDate,
      imageUrl: ogImageAbs,
      htmlContent: null,
      categoryName: category?.data.name,
      categoryPath: category ? `/${category.id}` : undefined,
      reviewer: TECHNICAL_REVIEWER,
    }),
    post.data.faq,
  );
  relatedPosts = pickRelatedPosts(post, await getCollection('posts'), 3);
} else {
  categoryPosts = (await getCollection('posts'))
    .filter((p) => p.data.publishedDate && p.data.category === props.category.id)
    .sort(newestFirst);
}
---

{post ? (
  <BaseLayout
    title={post.data.metaTitle?.trim() || post.data.title}
    description={post.data.metaDescription || ''}
    ogType="article"
    ogImageAbs={ogImageAbs}
    articlePublishedTime={articleIso}
    articleModifiedTime={articleModifiedIso}
    extraJsonLd={postJsonLd}
    tipoPagina="blog"
  >
    <BlogPost post={post} author={author} reviewer={TECHNICAL_REVIEWER} Content={Content} relatedPosts={relatedPosts} />
  </BaseLayout>
) : props.kind === 'category' ? (
  <BaseLayout
    title={props.category.data.name}
    description={`Colecao de artigos tecnicos da categoria ${props.category.data.name}.`}
    tipoPagina="blog"
  >
    <BlogList posts={categoryPosts} categoryName={props.category.data.name} />
  </BaseLayout>
) : null}
