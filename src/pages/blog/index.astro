---
/** Listagem do blog: todos os posts publicados, do mais recente para o mais antigo. */

import { getCollection } from 'astro:content';
import BaseLayout from '../../themes/cursodear/BaseLayout.astro';
import BlogList from '../../themes/cursodear/BlogList.astro';
import { newestFirst } from '../../utils/post-url';

const posts = (await getCollection('posts'))
  .filter((post) => post.data.publishedDate || post.data.date)
  .sort(newestFirst);
---

<BaseLayout
  tipoPagina="blog"
  title="Blog de Refrigeracao e Climatizacao | Dicas e Tutoriais Tecnicos"
  description="Artigos tecnicos sobre instalacao e manutencao de ar condicionado, refrigeracao e climatizacao. Conteudo pratico para tecnicos e iniciantes."
  canonicalOverride="https://cursodearcondicionado.com.br/blog/"
>
  <BlogList posts={posts} />
</BaseLayout>
