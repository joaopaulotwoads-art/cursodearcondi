---
import Header from './Header.astro';
import Footer from './Footer.astro';
import { SITE, NAV, FOOTER_NAV } from '../../data/site';
/** Open Sans — corpo e títulos (tipografia editorial legível, alinhada a Tailwind `font-sans` / `font-heading`) */
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/500.css';
import '@fontsource/open-sans/600.css';
import '@fontsource/open-sans/700.css';
import '@fontsource/open-sans/800.css';
import './global.css';
import {
  buildcursodearDefaultSiteJsonLd,
  buildOrganizationJsonLd,
  mergeJsonLdWithOrganization,
} from '../../utils/post-json-ld';
import {
  truncateOgTitle,
  resolveOgImageAbs,
  SEO_ORGANIZATION_NAME,
} from '../../utils/seo-meta';
import FaviconLinks from '../../components/FaviconLinks.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  keywords?: string;
  /** Esconde o menu do topo (landing pages: home, /automotivo/, /area-do-aluno/). */
  hideNav?: boolean;
  ogType?: 'website' | 'article';
  ogImageAbs?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  extraJsonLd?: Record<string, unknown> | null;
  canonicalOverride?: string;
  robots?: string;
  showFooter?: boolean;
  /** Tag `tipo_pagina` enviada ao Clarity. Sem valor explícito, posts (ogType article) contam como blog. */
  tipoPagina?: 'home' | 'blog' | 'curso';
}

const {
  title,
  description,
  canonical,
  keywords,
  hideNav = false,
  ogType = 'website',
  ogImageAbs,
  articlePublishedTime,
  articleModifiedTime,
  extraJsonLd,
  canonicalOverride,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  showFooter = true,
  tipoPagina = ogType === 'article' ? 'blog' : undefined,
} = Astro.props;
/** Título do documento: o que cada página passa em `title` (sem sufixo automático | marca). */
const fullTitle = title;
const fullDescription = description || '';
const metaKeywords = keywords || '';
const siteOrigin = SITE.url;
const path = Astro.url.pathname;
const canonicalPath = path.endsWith('/') ? path : `${path}/`;
const canonicalPageUrl =
  canonical || canonicalOverride || `https://cursodearcondicionado.com.br${canonicalPath}`;
const ogTitle = truncateOgTitle(fullTitle);
const resolvedOgImage = resolveOgImageAbs(siteOrigin, ogImageAbs);
const organizationJsonLd = buildOrganizationJsonLd({
  siteUrl: siteOrigin,
  name: SEO_ORGANIZATION_NAME,
});
const baseJsonLd =
  extraJsonLd ??
  buildcursodearDefaultSiteJsonLd({
    siteUrl: siteOrigin,
    siteName: SEO_ORGANIZATION_NAME,
    description: fullDescription || undefined,
  });
const jsonLdGraph = mergeJsonLdWithOrganization(baseJsonLd, organizationJsonLd);
---
<!DOCTYPE html>
<html lang="pt-BR" class="cursodear-root overflow-x-hidden">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {ogType === 'article' && (
    <link rel="preconnect" href="https://m.media-amazon.com" crossorigin />
  )}
  <FaviconLinks />
  <meta name="theme-color" content="#faf7f5" />
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-MPD65NHEQ7"></script>
  <!-- is:inline mantém gtag() global, usado pelo rastreamento de cliques abaixo -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    // ?debug_mode=true faz os eventos aparecerem no DebugView do GA4.
    gtag('config', 'G-MPD65NHEQ7', /[?&]debug_mode=true\b/.test(location.search) ? { debug_mode: true } : {});
  </script>
  <!-- Microsoft Clarity: só em produção -->
  <script is:inline define:vars={{ tipoPagina }}>
    if (location.hostname === 'cursodearcondicionado.com.br') {
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "zbhwrgxpff");
      if (tipoPagina) window.clarity('set', 'tipo_pagina', tipoPagina);
    }
  </script>
  <!-- Cliques em Hotmart e WhatsApp → mesmo evento no GA4 e no Clarity -->
  <script is:inline>
    (function () {
      function track(name, params, upgrade) {
        if (typeof window.gtag === 'function') {
          window.gtag('event', name, Object.assign({ transport_type: 'beacon' }, params));
        }
        if (typeof window.clarity === 'function') {
          window.clarity('event', name);
          if (upgrade) window.clarity('upgrade', upgrade);
        }
      }
      function posicao(el) {
        var marked = el.closest('[data-posicao]');
        if (marked) return marked.getAttribute('data-posicao');
        var doc = document.documentElement;
        var y = el.getBoundingClientRect().top + window.scrollY;
        var ratio = doc.scrollHeight > 0 ? y / doc.scrollHeight : 0;
        return ratio < 1 / 3 ? 'topo' : ratio < 2 / 3 ? 'meio' : 'fim';
      }
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a) return;
        var host;
        try { host = new URL(a.href, location.href).hostname; } catch (_) { return; }
        if (host === 'go.hotmart.com' || host === 'pay.hotmart.com' || host === 'hotm.art') {
          track('hotmart_click', {
            page_path: location.pathname,
            link_text: (a.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 100),
            posicao: posicao(a),
          }, 'hotmart');
        } else if (host === 'wa.me' || host === 'api.whatsapp.com') {
          track('whatsapp_click', { page_path: location.pathname });
        }
      }, true);
    })();
  </script>
  <title>{fullTitle}</title>
  <meta name="description" content={fullDescription} />
  {metaKeywords && <meta name="keywords" content={metaKeywords} />}
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonicalPageUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={fullDescription} />
  <meta property="og:url" content={canonicalPageUrl} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:image" content={resolvedOgImage} />
  <meta property="og:image:alt" content={SEO_ORGANIZATION_NAME} />
  {ogType === 'article' && articlePublishedTime && (
    <meta property="article:published_time" content={articlePublishedTime} />
  )}
  {ogType === 'article' && articleModifiedTime && (
    <meta property="article:modified_time" content={articleModifiedTime} />
  )}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={fullDescription} />
  <meta name="twitter:image" content={resolvedOgImage} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
  <style is:global>
    html {
      scroll-padding-top: 80px;
    }
  </style>
</head>
<body class="cursodear-scope min-w-0 overflow-x-hidden bg-[var(--color-bg)] text-[var(--color-text)] antialiased">
  <Header siteName={SITE.name} logoSrc={SITE.logo} nav={hideNav ? [] : NAV} />
  <main class="min-w-0"><slot /></main>
  {showFooter && <Footer siteName={SITE.name} logoSrc={SITE.logo} footerNav={FOOTER_NAV} />}
</body>
</html>
