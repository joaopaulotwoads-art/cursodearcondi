---
import { postUrl } from '../../utils/post-url';
import { resolvecursodearMediaUrl } from '../../utils/media-url';

interface Props {
  posts: any[];
  /** Nome da categoria (páginas /<categoria>/); vazio na listagem /blog/. */
  categoryName?: string;
}

const { posts, categoryName } = Astro.props;
---
<article class="max-w-4xl mx-auto px-4 py-12">
  <header class="mb-10">
    <h1 class="text-3xl font-extrabold tracking-tight text-[var(--color-heading)] md:text-4xl">
      {categoryName || 'Blog'}
    </h1>
    {categoryName && (
      <p class="mt-2">
        <a href="/blog" class="text-sm font-medium text-[var(--color-link)] no-underline hover:underline">Ver todos os artigos</a>
      </p>
    )}
  </header>
  {posts.length === 0 ? (
    <p class="text-[var(--color-muted)]">Nenhum post publicado ainda.</p>
  ) : (
    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
      {posts.map((post) => {
        const url = postUrl(post);
        const thumb = resolvecursodearMediaUrl(post.data.thumbnail || post.data.metaImage);
        const date = post.data.publishedDate || post.data.date;
        const categoryLabel = post.data.category || 'Geral';
        return (
          <a
            href={url}
            class="group block rounded-lg border border-[var(--color-border)] bg-white overflow-hidden hover:border-[var(--color-link)] transition-colors"
          >
            {thumb ? (
              <div class="aspect-[4/3] overflow-hidden bg-[var(--color-surface)]">
                <img
                  src={thumb}
                  alt=""
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ) : (
              <div class="aspect-[4/3] bg-orange-100 flex items-center justify-center text-orange-600 text-sm font-semibold">
                Curso de Ar Condicionado
              </div>
            )}
            <div class="p-4">
              <span class="inline-flex rounded-full bg-orange-500 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white">
                {categoryLabel}
              </span>
              {date && (
                <time class="mt-2 block text-xs text-[var(--color-muted)]" datetime={date}>
                  {new Date(date).toLocaleDateString('pt-BR', { timeZone: 'UTC' })}
                </time>
              )}
              <h2 class="mt-1 text-lg font-semibold text-[var(--color-heading)] group-hover:text-[var(--color-link)]">{post.data.title}</h2>
              {post.data.metaDescription && (
                <p class="text-sm text-[var(--color-muted)] mt-1 line-clamp-2">{post.data.metaDescription}</p>
              )}
              <span class="mt-3 inline-block text-sm font-semibold text-orange-600 group-hover:underline">
                Ler mais →
              </span>
            </div>
          </a>
        );
      })}
    </div>
  )}
</article>
